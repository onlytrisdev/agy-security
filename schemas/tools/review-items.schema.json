{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agy-security://schemas/tools/review-items.schema.json",
  "$defs": {
    "prepareInput": {
      "type": "object",
      "properties": {
        "scanId": {
          "$ref": "agy-security://schemas/definitions/artifact-common.schema.json#/$defs/scanId"
        },
        "handoffClaimToken": {
          "$ref": "agy-security://schemas/definitions/artifact-common.schema.json#/$defs/nonEmptyText"
        }
      },
      "required": ["scanId"],
      "additionalProperties": false
    },
    "reviewItemsInput": {
      "type": "object",
      "properties": {
        "scanId": {
          "$ref": "agy-security://schemas/definitions/artifact-common.schema.json#/$defs/scanId"
        },
        "handoffClaimToken": {
          "$ref": "agy-security://schemas/definitions/artifact-common.schema.json#/$defs/nonEmptyText"
        },
        "cursor": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)$" },
        "limit": { "type": "integer", "minimum": 1, "maximum": 1000 }
      },
      "required": ["scanId"],
      "additionalProperties": false
    },
    "reviewItem": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "agy-security://schemas/definitions/artifact-common.schema.json#/$defs/repositoryPath"
        }
      },
      "required": ["path"],
      "additionalProperties": false
    }
  }
}
