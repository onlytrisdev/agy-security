#!/bin/sh
set -eu

PATH="${PATH:-/usr/bin:/bin}:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
export PATH

launcher_dir=$(CDPATH= cd "$(dirname "$0")" && pwd)
server_path=$launcher_dir/../mcp/server.mjs
if [ "${1:-}" = "--helper" ]; then
  server_path=$launcher_dir/../mcp/helpers.mjs
fi

launch_node() {
  node_command=$1
  shift
  if [ "${1:-}" = "--helper" ]; then
    shift
    helper_stdin=-
    if (exec 4<&0) 2>&-; then
      exec 4<&0
      helper_stdin=4
    fi
    wait_helper() {
      if wait "$!" 2>&-; then exit 0; else exit $?; fi
    }
    forward_signal() {
      if [ -n "${!:-}" ]; then
        kill -s "$1" "$!" 2>&- || :
        wait_helper
      fi
      exit "$2"
    }
    trap 'forward_signal HUP 129' HUP
    trap 'forward_signal INT 130' INT
    trap 'forward_signal TERM 143' TERM
    printf '%s\000' "${HOME+x}" "${HOME-}" "$@" | od -An -v -tx1 | tr -d ' \n' |
      "$node_command" "$server_path" --helper 3<&0 0<&"$helper_stdin" 4<&- &
    exec 4<&-
    wait_helper
  fi
  exec "$node_command" "$server_path" "$@"
}

if [ -n "${AGY_MCP_NODE_PATH:-}" ] && [ -x "$AGY_MCP_NODE_PATH" ]; then
  launch_node "$AGY_MCP_NODE_PATH" "$@"
fi

if command -v node >/dev/null 2>&1; then
  launch_node "$(command -v node)" "$@"
fi

printf '%s\n' 'AGY Security could not find a Node runtime. Set AGY_MCP_NODE_PATH or add node to PATH.' >&2
exit 127
